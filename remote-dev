def remote_command(action, paths=None, browser=False, target=None, workspace=None):
    payload = json.dumps({'action': action, 'paths': paths or [], 'target': target,
                          'workspace': workspace, 'browser': browser}, sort_keys=True)
    return shlex.join(['python3', '-c', REMOTE_BOOTSTRAP, payload])


def within(path, base):
    try:
        Path(path).relative_to(Path(base).expanduser().resolve())
        return True
    except ValueError:
        return False


# Modes a remote TUI may leave on when its channel ends: cursor keys, mouse tracking and encodings,
# focus, bracketed paste, synchronized output; finally show the cursor.
TERMINAL_MODES = ('\033[?1l\033[?1000l\033[?1002l\033[?1003l\033[?1005l\033[?1006l\033[?1015l'
                  '\033[?1004l\033[?2004l\033[?2026l\033[?25h')
ALTERNATE_SCREEN_EXIT = '\033[?1049l'
KEYBOARD_RESET = '\033[<99u'  # pop every kitty keyboard flag entry of the current screen


def restore_terminal(clean):
    """Reset modes after a Claude channel; a clean exit already left the alternate screen."""
    if not sys.stdout.isatty():
        return
    with contextlib.suppress(OSError, ValueError):
        sys.stdout.write(('' if clean else ALTERNATE_SCREEN_EXIT) + KEYBOARD_RESET + TERMINAL_MODES)
        sys.stdout.flush()


def reap(child):
    if child is not None and child.poll() is None:
        child.terminate()
        try:
            child.wait(timeout=3)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()


def target_key(host, port):
    return hashlib.sha256(('%s:%d' % (host, port)).encode()).hexdigest()[:12]


def describe(values):
    target = '%s:%d' % (values['host'], values['ssh_port'])
    return '%s (%s)' % (values['name'], target) if values.get('name') else target


def split_target(host):
    user, _, name = host.rpartition('@')
    return user, name.strip('[]')


def parse_query(query):
    """Split a --host value into (target, port or None, literal). '=TARGET' skips matching."""
    literal = query.startswith('=')
    query = query[1:] if literal else query
    match = re.fullmatch(r'((?:[^@]*@)?(?:\[[^\]]*\]|[^:\[\]]+)):(\d+)', query)
    if match:
        return match.group(1), int(match.group(2)), literal
    return query, None, literal


def prefix_matches(name, prefix):
    """A prefix that does not end inside a number: server1 does not select server10."""
    if not prefix or not name.startswith(prefix):
        return False
    following = name[len(prefix):len(prefix) + 1]
    return not (following.isdigit() and prefix[-1].isdigit())


def match_targets(query, candidates):
    """An exact name or target first, otherwise name and hostname prefixes (a given user must match)."""
    query, port, literal = parse_query(query)
    candidates = [item for item in candidates if port is None or item['ssh_port'] == port]
    exact = [item for item in candidates if query in (item['host'], item.get('name'))]
    if exact or literal:
        return exact
    user, name = split_target(query)
    return [item for item in candidates
            if (not user and prefix_matches(item.get('name') or '', name))
            or (prefix_matches(split_target(item['host'])[1], name)
                and (not user or split_target(item['host'])[0] == user))]


def ambiguous(query, found):
    return RuntimeError('%s matches several targets: %s; use a longer --host, HOST:PORT, or =TARGET for an exact one'
                        % (query, ', '.join(describe(item) for item in found)))


def warn_diverged(store, values, items):
    for item in items:
        print('Warning: transcript %s on %s diverged from the local copy; its version is kept in %s and not '
              'overwritten there' % (item, describe(values), store.conflicts(values['key']) / item),
              file=sys.stderr, flush=True)


class Sync:
    """Pull periodically while Claude runs and once after it exits."""

    def __init__(self, controller, store, values, remote, name):
        self.controller, self.store, self.values, self.remote, self.name = controller, store, values, remote, name
        value = os.environ.get('REMOTE_DEV_SYNC_INTERVAL', str(sessions.INTERVAL))
        if not value.isdigit():
            raise ValueError('REMOTE_DEV_SYNC_INTERVAL must be whole seconds; 0 disables periodic sync')
        self.interval, self.diverged, self.stopped = int(value), [], threading.Event()

    def start(self):
        def loop():
            while not self.stopped.wait(self.interval):
                with contextlib.suppress(OSError, RuntimeError, subprocess.SubprocessError):
                    with self.store.lock():
                        self.diverged += self.remote.pull(self.store, self.values['key'])[1]
        if self.interval:
            background(loop)

    def finish(self):
        self.stopped.set()
        key = self.values['key']
        try:
            with self.store.lock():
                self.diverged += self.remote.pull(self.store, key)[1]
                if not self.controller.busy(key, self.name):
                    self.store.set_pending(key)
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            print('Warning: transcripts on %s were not synced back: %s; run remote-dev sync -H %s later'
                  % (describe(self.values), error, self.values.get('name') or self.values['host']),
                  file=sys.stderr, flush=True)
        warn_diverged(self.store, self.values, self.diverged)


class Controller:
    def __init__(self, home=None, runtime_dir=None):
        self.home = Path(home or Path.home())
        self.data = self.home / '.local/share/remote-dev'
        self.config_dir = self.home / '.config/remote-dev/devspace'
        self.config_file = self.config_dir / 'config.jsonc'
        self.targets_file = self.home / '.config/remote-dev/targets.json'
        self.unit_file = self.home / '.config/systemd/user' / UNIT
        self.runtime = Path(runtime_dir or Path(os.environ.get('XDG_RUNTIME_DIR',
                              '/run/user/' + str(os.getuid()))))
        if runtime_dir is None:
            self.runtime = self.runtime / 'remote-dev'
        self.connections_dir = self.runtime / 'connections'
        self.shared_file = self.runtime / 'shared.json'
        self.sessions_dir = self.runtime / 'sessions'
        self.browser = Browser(self.home)

    def paths(self, key):
        if key == LEGACY:
            base, unit, lock = self.runtime, WATCH_UNIT, 'startup.lock'
        else:
            base, unit, lock = self.connections_dir / key, 'remote-dev-link-%s.service' % key, 'locks/%s.lock' % key
        return types.SimpleNamespace(dir=base, connection=base / 'connection.json', ssh=base / 'ssh.sock',
                                     clipboard=base / 'clipboard.sock', unit=unit, lock=lock)

    @contextlib.contextmanager
    def lock(self, name='control.lock', nonblocking=False):
        path = self.runtime / name
        private_dir(self.runtime)
        private_dir(path.parent)
        with path.open('a') as stream:
            os.chmod(stream.name, 0o600)
            try:
                fcntl.flock(stream, fcntl.LOCK_EX | (fcntl.LOCK_NB if nonblocking else 0))
            except BlockingIOError as error:
                raise BusyError('Another remote-dev operation is starting; inspect status before retrying') from error
            yield

    def read_connection(self, key):
        try:
            value = json.loads(self.paths(key).connection.read_text())
        except FileNotFoundError:
            return None
        value['key'] = key
        return value

    def write_connection(self, value):
        atomic_json(self.paths(value['key']).connection, value)

    def connections(self):
        found = [value for value in [self.read_connection(LEGACY)] if value]
        if self.connections_dir.is_dir():
            for directory in sorted(self.connections_dir.iterdir()):
                value = self.read_connection(directory.name)
                if value:
                    found.append(value)
        return sorted(found, key=lambda item: (item['host'], item['ssh_port']))

    def read_shared(self):
        try:
            return json.loads(self.shared_file.read_text())
        except FileNotFoundError:
            return {}

    def write_shared(self, value):
        value = {key: item for key, item in value.items() if item}
        if value:
            atomic_json(self.shared_file, value)
        else:
            self.shared_file.unlink(missing_ok=True)

    def read_targets(self):
        try:
            targets = json.loads(self.targets_file.read_text()).get('targets', [])
        except FileNotFoundError:
            return []
        except (ValueError, AttributeError) as error:
            raise RuntimeError('Remembered targets are unreadable; fix or remove ' + str(self.targets_file)) from error
        targets = [item for item in targets if isinstance(item, dict) and isinstance(item.get('host'), str)
                   and isinstance(item.get('ssh_port'), int)]
        return sorted(targets, key=lambda item: item.get('last_used', 0), reverse=True)

    def save_target(self, host, port, identity_file, keep=True, name=None):
        """Update targets.json; the caller holds the control lock. A missing name keeps the old one."""
        targets = self.read_targets()
        previous = [item for item in targets if (item['host'], item['ssh_port']) == (host, port)]
        targets = [item for item in targets if item not in previous]
        if keep:
            name = name or (previous[0].get('name') if previous else None)
            targets.insert(0, {'host': host, 'ssh_port': port, 'identity_file': identity_file,
                               'name': name, 'last_used': int(time.time())})
        atomic_json(self.targets_file, {'targets': targets})

    def remember(self, *args, **kwargs):
        with self.lock():
            self.save_target(*args, **kwargs)

    def target(self, host, port, identity_file, name=None):
        """Resolve, validate and announce a target for start/install/uninstall."""
        with self.lock():
            target = self.resolve_start(host, port, identity_file)
            if name:
                if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', name):
                    raise ValueError('--name may contain letters, digits, ".", "_" and "-"')
                owner = next((item for item in self.read_targets() if item.get('name') == name), None)
                if owner and (owner['host'], owner['ssh_port']) != (target['host'], target['ssh_port']):
                    raise ValueError('%s already names %s' % (name, describe(owner)))
                target['name'] = name
        validate_host(target['host'])
        ssh_options(target['ssh_port'], target['identity_file'])
        if target['identity_file']:
            target['identity_file'] = str(Path(target['identity_file']).expanduser().resolve())
        if target['note']:
            print('Target %s (%s).' % (describe(target), target['note']), flush=True)
        return target

    def resolve_start(self, host, port, identity_file):
        active = self.connections()
        note = None
        if host is None:
            if len(active) == 1:
                base, note = active[0], 'running connection'
            elif active:
                raise RuntimeError('Several connections are running: %s; pass --host'
                                   % ', '.join(describe(item) for item in active))
            else:
                targets = self.read_targets()
                if not targets:
                    raise RuntimeError('No previous target is remembered; pass --host USER@HOST')
                base, note = targets[0], 'last used'
        else:
            target, query_port, _ = parse_query(host)
            if port is not None and query_port is not None and port != query_port:
                raise ValueError('--host %s and --ssh-port %d disagree' % (host, port))
            port = query_port if port is None else port
            candidates = {}
            for item in active + self.read_targets():
                candidates.setdefault((item['host'], item['ssh_port']), item)
            candidates = [item for item in candidates.values() if port is None or item['ssh_port'] == port]
            found = match_targets(host, candidates)
            if len(found) > 1:
                raise ambiguous(host, found)
            if found:
                base = found[0]
                note = None if base['host'] == target else 'matched "%s"' % host
            else:
                validate_host(target)
                base = {'host': target, 'ssh_port': 22, 'identity_file': None}
        return {'host': base['host'], 'ssh_port': base['ssh_port'] if port is None else port,
                'identity_file': identity_file or base.get('identity_file'), 'name': base.get('name'), 'note': note}

    def resolve_active(self, host=None):
        active = self.connections()
        query = host or os.environ.get('REMOTE_DEV_HOST')
        if query:
            found = match_targets(query, active)
            if not found:
                raise RuntimeError('No running connection matches %s; run remote-dev start --host %s' % (query, query))
            if len(found) > 1:
                raise ambiguous(query, found)
            return found[0]
        if not active:
            raise RuntimeError('Run remote-dev start --host USER@HOST first')
        if len(active) > 1:
            raise RuntimeError('Several connections are running: %s; pass --host or set REMOTE_DEV_HOST'
                               % ', '.join(describe(item) for item in active))
        return active[0]

    def read_config(self):
        try:
            return json.loads(self.config_file.read_text())
        except json.JSONDecodeError as error:
            raise ValueError('DevSpace configuration must be strict JSON (no comments or trailing commas): '
                             + str(self.config_file)) from error

    def systemctl(self, *args, check=True, unit=UNIT):
        return subprocess.run(['systemctl', '--user', *args, *([] if args[0] == 'daemon-reload' else [unit])],
                              check=check, capture_output=True, text=True)

    def service_active(self):
        return self.systemctl('is-active', check=False).returncode == 0

    def install(self, host=None, port=None, identity_file=None, browser=False, install_node=False, name=None):
        if host is None:
            return provisioning.install(self, ROOT, None, 22, None, browser, install_node)
        target = self.target(host, port, identity_file, name)
        provisioning.install(self, ROOT, target['host'], target['ssh_port'], target['identity_file'],
                             browser, install_node)
        self.remember(target['host'], target['ssh_port'], target['identity_file'], name=target['name'])

    def uninstall(self, host=None, port=None, identity_file=None):
        target = self.target(host, port, identity_file) if host else None
        self.stop(everything=True)
        if target is None:
            return provisioning.uninstall(self, ROOT, None, 22, None)
        provisioning.uninstall(self, ROOT, target['host'], target['ssh_port'], target['identity_file'])
        self.remember(target['host'], target['ssh_port'], None, keep=False)

    def master_command(self, values):
        paths = self.paths(values['key'])
        args = ['ssh', '-M', '-S', str(paths.ssh), '-fNT',
                '-o', 'ControlPersist=no',
                '-o', 'ExitOnForwardFailure=yes',
                '-o', 'ServerAliveInterval=15', '-o', 'ServerAliveCountMax=2',
                '-R', '127.0.0.1:7676:127.0.0.1:7676',
                '-R', '127.0.0.1:%d:%s' % (clipboard.PORT, paths.clipboard)]
        if values['browser']:
            args += list(BROWSER_FORWARD)
        args += ssh_options(values['ssh_port'], values.get('identity_file'))
        return args + [values['host']]

    def ssh_prefix(self, values, tty=False):
        """ssh via the connection's master, without target and command."""
        return ['ssh', '-t' if tty else '-T', '-S', str(self.paths(values['key']).ssh),
                '-p', str(values['ssh_port']), '-o', 'ControlMaster=no',
                '-o', 'ProxyCommand=false', '-o', 'BatchMode=yes', '-o', 'ForwardAgent=no']

    def channel_command(self, values, command, tty=True):
        return self.ssh_prefix(values, tty) + [values['host'], command]

    def control(self, values, action, *args):
        return subprocess.run(['ssh', '-S', str(self.paths(values['key']).ssh), '-O', action,
            *args, '-p', str(values['ssh_port']), '-o', 'BatchMode=yes', values['host']],
            capture_output=True, text=True, timeout=5)

    def connection_ready(self, values):
        return (values.get('phase') == 'ready' and self.service_active()
                and self.control(values, 'check').returncode == 0)

    def wait_health(self):
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        deadline = time.monotonic() + 20
        while time.monotonic() < deadline:
            try:
                with opener.open('http://127.0.0.1:7676/healthz', timeout=1) as response:
                    if json.load(response).get('name') == 'devspace':
                        return
            except (OSError, ValueError):
                pass
            time.sleep(0.2)
        raise RuntimeError('DevSpace did not become healthy; inspect journalctl --user -u ' + UNIT)

    def prepare(self, values, browser):
        """Check the remote side and install the clipboard shim and token over stdin."""
        token = values.get('clipboard_token')
        request = json.dumps({'token': token, 'xclip': clipboard.SHIM}) if token else ''
        result = subprocess.run(self.channel_command(values, remote_command('prepare', browser=browser), tty=False),
                                input=request, text=True)
        if result.returncode:  # the remote side has printed the reason
            raise RuntimeError('Remote preparation of %s failed; if it lacks remote-dev, run: remote-dev install -H %s%s'
                               % (describe(values), values.get('name') or values['host'], ' --browser' if browser else ''))

    def acquire_browser(self, shared):
        """Start or borrow Chrome; ownership survives only while the same session file is current."""
        acquired = self.browser.start()
        shared['browser_owned'] = acquired['created_browser'] or (
            shared.get('browser_owned', False) and shared.get('browser_stamp') == acquired['session_stamp'])
        shared['browser_stamp'] = acquired['session_stamp']
        return acquired

    def enable_browser(self, values):
        if values['key'] == LEGACY:
            raise RuntimeError('This connection was started by an older remote-dev; run stop, then start with --browser')
        self.prepare(values, True)
        updated = dict(values)
        before = self.read_shared()
        shared = dict(before)
        cancel_forward = recorded = False
        acquired = None
        try:
            with defer_signals():
                acquired = self.acquire_browser(shared)
                recorded = True
                self.write_shared(shared)
                if not values['browser']:
                    cancel_forward = True
                    result = self.control(values, 'forward', *BROWSER_FORWARD)
                    if result.returncode:
                        cancel_forward = False
                        raise RuntimeError('Browser forwarding failed: ' + result.stderr.strip())
                updated['browser'] = True
                self.write_connection(updated)
        except BaseException:
            with defer_signals():
                if cancel_forward:
                    result = self.control(values, 'cancel', *BROWSER_FORWARD)
                    if result.returncode:
                        raise RuntimeError('Browser forwarding rollback failed; inspect status and retry stop: '
                                           + result.stderr.strip())
                if acquired and acquired['created_browser']:
                    self.browser.stop(expected_stamp=acquired['session_stamp'])
                if recorded:
                    self.write_shared(before)
                    self.write_connection(values)
            raise

    def move_oauth(self, values):
        """Point the local OAuth callback at this connection; call under the control lock."""
        shared = self.read_shared()
        holder = shared.get('oauth_holder')
        if values['key'] == LEGACY or holder == values['key']:
            return False
        previous = self.read_connection(holder) if holder else None
        if previous:
            self.control(previous, 'cancel', *OAUTH_FORWARD)
        shared.pop('oauth_holder', None)
        self.write_shared(shared)
        result = self.control(values, 'forward', *OAUTH_FORWARD)
        if result.returncode:
            if previous and self.control(previous, 'forward', *OAUTH_FORWARD).returncode == 0:
                shared['oauth_holder'] = previous['key']
                self.write_shared(shared)
            raise RuntimeError('Local port 8765 could not be forwarded; check for another listener: '
                               + result.stderr.strip())
        shared['oauth_holder'] = values['key']
        self.write_shared(shared)
        return True

    def auth(self, host=None):
        with self.lock():
            values = self.resolve_active(host)
            if not self.connection_ready(values):
                raise RuntimeError('Connection to %s is not ready; inspect remote-dev status' % describe(values))
            moved = self.move_oauth(values)
        print('OAuth callback 8765 %s %s.' % ('now forwards to' if moved else 'already forwards to', describe(values)))

    def start(self, host=None, port=None, browser=False, identity_file=None, name=None):
        target = self.target(host, port, identity_file, name)
        host, port, identity_file, name = target['host'], target['ssh_port'], target['identity_file'], target['name']
        key = target_key(host, port)
        paths = self.paths(key)
        with self.lock(paths.lock, nonblocking=True):
            values, child, started = None, None, False
            try:
                with self.lock():
                    existing = self.read_connection(key)
                    if existing:
                        current = (existing['host'], existing['ssh_port'], existing.get('identity_file'))
                        if current == (host, port, identity_file) and self.connection_ready(existing):
                            if name != existing.get('name'):
                                existing['name'] = name
                                self.write_connection(existing)
                                self.save_target(host, port, identity_file, name=name)
                            if browser:
                                self.enable_browser(existing)
                            print('Shared connection and browser are ready.' if browser
                                  else 'Shared connection is already running.')
                            return
                        raise RuntimeError('A connection to %s is recorded; inspect status and stop it before changing it'
                                           % describe(existing))
                    active = self.connections()
                    legacy = [item for item in active if item['key'] == LEGACY]
                    if legacy:
                        if (legacy[0]['host'], legacy[0]['ssh_port']) == (host, port):
                            if browser:
                                self.enable_browser(legacy[0])
                            print('Shared connection is already running.')
                            return
                        raise RuntimeError('A connection from an older remote-dev is running; run remote-dev stop first')
                    shared = self.read_shared()
                    service = self.service_active()
                    if service and not active and not shared.get('devspace_owned'):
                        raise RuntimeError('Untracked access exists; inspect status and run stop first')
                    self.remove_stale_socket(paths.ssh)
                    if not self.config_file.exists():
                        raise RuntimeError('Run remote-dev install first')
                    config = self.read_config()
                    scope = canonical_paths(config.get('workspaces', {}).get('allowedRoots', []))
                    if not service:
                        require_free_port(7676)
                    values = {'id': str(uuid.uuid4()), 'key': key, 'phase': 'starting', 'host': host,
                              'ssh_port': port, 'scope': scope, 'browser': browser,
                              'identity_file': identity_file, 'name': name, 'clipboard_token': secrets.token_hex(16),
                              'controller': process_record(os.getpid()), 'watcher_owned': False}
                    self.write_connection(values)
                    if not service:
                        shared['devspace_owned'] = True
                        self.write_shared(shared)
                        self.systemctl('start')
                    self.wait_health()
                    if browser:
                        with defer_signals():
                            shared = self.read_shared()
                            self.acquire_browser(shared)
                            self.write_shared(shared)
                    print('Host DevSpace ready. Connecting to ' + describe(values) + '.', flush=True)
                    with defer_signals() as previous_mask:
                        child = subprocess.Popen(self.master_command(values),
                            preexec_fn=lambda: signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask))
                        values['ssh'] = process_record(child.pid)
                        self.write_connection(values)
                if child.wait() != 0:
                    raise RuntimeError('SSH startup failed; check authentication and forwarding ports. If this server '
                                       'is already connected under another name or user, its ports 7676/7677 are taken')
                with self.lock():
                    if not self.read_connection(key):
                        raise RuntimeError('Startup was stopped')
                    check = self.control(values, 'check')
                    match = re.search(r'pid=(\d+)', check.stdout + check.stderr)
                    if check.returncode or not match:
                        raise RuntimeError('The shared SSH master is not ready')
                    values['ssh'] = process_record(int(match.group(1)))
                    self.write_connection(values)
                self.prepare(values, browser)
                with self.lock():
                    if not self.read_connection(key):
                        raise RuntimeError('Startup was stopped')
                    values['phase'] = 'ready'
                    values['controller'] = None
                    self.write_connection(values)
                    with defer_signals():
                        subprocess.run(['systemd-run', '--user', '--quiet', '--collect',
                            '--unit=' + paths.unit, '--property=Restart=no',
                            '--property=KillMode=control-group', '--property=TimeoutStopSec=10',
                            sys.executable, str(Path(__file__).resolve()), '_watch', key, values['id']], check=True)
                        values['watcher_owned'] = True
                        self.write_connection(values)
                started = True
                try:
                    self.remember(host, port, identity_file, name=name)
                except (OSError, RuntimeError) as error:
                    print('Warning: target not remembered: ' + str(error), file=sys.stderr, flush=True)
                print('Shared connection to %s ready. Run remote-dev open in any project terminal.' % describe(values))
            finally:
                reap(child)
                if values and not started:
                    self.cleanup(key, values['id'], acquired=values)
                    if values.get('watcher_owned'):
                        self.systemctl('stop', unit=paths.unit, check=False)

    def open(self, paths, client='claude', host=None):
        if client != 'claude':
            raise ValueError('Codex is planned; only Claude is implemented')
        paths = canonical_paths(paths or [Path.cwd()])
        name = sessions.workspace_name(socket.gethostname(), paths)
        identifier, child, code, sync = str(uuid.uuid4()), None, None, None
        try:
            with self.lock():
                values = self.resolve_active(host)
                if not self.connection_ready(values):
                    raise RuntimeError('Connection to %s is not ready; inspect remote-dev status' % describe(values))
                for path in paths:
                    if not any(within(path, base) for base in values['scope']):
                        raise ValueError('Path is outside configured development roots: ' + path +
                                         '; edit ' + str(self.config_file) + ' while stopped, then start again')
            sync = self.sync_open(values, name)
            with self.lock():
                try:  # a local-dev login usually follows open, so the callback follows the session
                    if self.move_oauth(values):
                        print('OAuth callback 8765 now forwards to %s.' % describe(values), flush=True)
                except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                    print('Warning: ' + str(error), file=sys.stderr, flush=True)
                command = remote_command('open', paths, values['browser'], values.get('name') or values['host'], name)
                with defer_signals() as previous_mask:
                    child = subprocess.Popen(self.channel_command(values, command),
                        preexec_fn=lambda: signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask))
                    atomic_json(self.sessions_dir / (identifier + '.json'), {
                        'id': identifier, 'client': client, 'connection': values['key'], 'paths': paths,
                        'workspace': name, 'ssh': process_record(child.pid)})
            print('Claude session %s on %s: %s' % (identifier[:8], describe(values), ', '.join(paths)), flush=True)
            if sync:
                sync.start()
            code = child.wait()
            return code
        finally:
            reap(child)
            if child is not None:
                restore_terminal(clean=code == 0)
            with self.lock():
                (self.sessions_dir / (identifier + '.json')).unlink(missing_ok=True)
            if sync:
                sync.finish()

    def transcripts(self, values, name):
        """Transcript transfer for a connection; None without local rsync."""
        if not shutil.which('rsync'):
            return None
        cache = sessions.Store(self.data / 'sessions', name).state_file(values['key'], '.location')
        return sessions.Remote(self.ssh_prefix(values), values['host'], name, cache)

    def busy(self, key, name):
        """Whether a live session of this workspace runs on that connection."""
        return any(record.get('connection') == key and record.get('workspace') == name
                   and same_process(record.get('ssh')) for _, record in self.sessions())

    def pull(self, store, values, remote):
        changed, diverged = remote.pull(store, values['key'])
        warn_diverged(store, values, diverged)
        return changed

    def sync_open(self, values, name):
        """Sync transcripts before Claude starts; failures only warn."""
        remote = self.transcripts(values, name)
        if remote is None:
            print('Warning: rsync not found; transcripts are not synced across servers', file=sys.stderr, flush=True)
            return None
        store = sessions.Store(self.data / 'sessions', name)
        sync = Sync(self, store, values, remote, name)
        with store.lock():
            for key, label in store.pending().items():
                if key == values['key']:
                    continue
                other = self.read_connection(key)
                try:
                    if not other or not self.connection_ready(other):
                        raise RuntimeError('it is not connected; start it and run remote-dev sync')
                    self.pull(store, other, self.transcripts(other, name))
                    if not self.busy(key, name):
                        store.set_pending(key)
                except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                    print('Warning: transcripts on %s may be newer than the local copy: %s' % (label, error),
                          file=sys.stderr, flush=True)
            try:
                self.pull(store, values, remote)
                remote.push(store, values['key'])
            except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                print('Warning: transcripts were not synced with %s: %s' % (describe(values), error),
                      file=sys.stderr, flush=True)
            store.set_pending(values['key'], describe(values))
        return sync

    def sync(self, paths=None, host=None):
        if not shutil.which('rsync'):
            raise RuntimeError('Install rsync locally to sync transcripts')
        paths = canonical_paths(paths or [Path.cwd()])
        name = sessions.workspace_name(socket.gethostname(), paths)
        with self.lock():
            selected = [self.resolve_active(host)] if host else self.connections()
            selected = [values for values in selected if self.connection_ready(values)]
        if not selected:
            raise RuntimeError('No running connection to sync with')
        store = sessions.Store(self.data / 'sessions', name)
        with store.lock():
            remotes = [(values, self.transcripts(values, name)) for values in selected]
            moved = [('From', values, self.pull(store, values, remote)) for values, remote in remotes]
            for values, remote in remotes:
                moved.append(('To', values, remote.push(store, values['key'])))
                if not self.busy(values['key'], name):
                    store.set_pending(values['key'])
            missing = [label for key, label in store.pending().items()
                       if key not in {values['key'] for values in selected}]
        print('Synced transcripts of %s with %s.' % (name, ', '.join(describe(values) for values in selected)))
        for direction, values, changes in moved:
            if changes:
                print('  %s %s:' % (direction, describe(values)))
                for line in sessions.summarize(changes, store.main):
                    print('    ' + line)
        if not any(changes for _, _, changes in moved):
            print('  Already up to date.')
        if missing:
            print('Not connected, may hold newer transcripts: ' + ', '.join(missing))

    def sessions(self):
        records = []
        for path in sorted(self.sessions_dir.glob('*.json')):
            try:
                records.append((path, json.loads(path.read_text())))
            except FileNotFoundError:
                pass
        return records

    def cleanup(self, key, identifier, acquired=None):
        with self.lock():
            paths = self.paths(key)
            values = self.read_connection(key)
            if acquired and (not values or values.get('id') == identifier):
                values = acquired
            if not values or values.get('id') != identifier:
                return
            errors = []
            try:
                if paths.ssh.exists():
                    self.control(values, 'exit')
                terminate(values.get('ssh'))
                for path, session in self.sessions():
                    if session.get('connection', LEGACY) == key:
                        terminate(session.get('ssh'))
                        path.unlink(missing_ok=True)
            except (OSError, subprocess.SubprocessError) as error:
                errors.append(str(error))
            if errors:
                raise RuntimeError('Cleanup incomplete; retry stop: ' + '; '.join(errors))
            if key == LEGACY:
                shared = self.read_shared()
                if values.get('service_owned'):
                    shared['devspace_owned'] = True
                if values.get('browser_owned'):
                    shared.update(browser_owned=True, browser_stamp=values.get('browser_stamp'))
                self.write_shared(shared)
            paths.connection.unlink(missing_ok=True)
            paths.ssh.unlink(missing_ok=True)
            paths.clipboard.unlink(missing_ok=True)
            if key != LEGACY:
                with contextlib.suppress(OSError):
                    paths.dir.rmdir()
            self.release_shared()

    def release_shared(self):
        """Stop owned DevSpace/Chrome once no remaining connection uses them. Call under the control lock."""
        remaining = self.connections()
        shared = self.read_shared()
        errors = []
        if shared.get('oauth_holder') not in [item['key'] for item in remaining]:
            shared.pop('oauth_holder', None)
        if shared.get('devspace_owned') and not remaining:
            try:
                self.systemctl('stop')
                shared.pop('devspace_owned')
            except subprocess.SubprocessError as error:
                errors.append(str(error))
        if shared.get('browser_owned') and not any(item.get('browser') for item in remaining):
            try:
                self.browser.stop(expected_stamp=shared.get('browser_stamp'))
                shared.pop('browser_owned')
                shared.pop('browser_stamp', None)
            except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                errors.append(str(error))
        self.write_shared(shared)
        if errors:
            raise RuntimeError('Cleanup incomplete; retry stop: ' + '; '.join(errors))

    @staticmethod
    def remove_stale_socket(path):
        try:
            mode = path.lstat().st_mode
        except FileNotFoundError:
            return
        if not stat.S_ISSOCK(mode):
            raise RuntimeError('Unexpected file at SSH control socket path; inspect ' + str(path))
        with socket.socket(socket.AF_UNIX) as probe:
            probe.settimeout(1)
            try:
                probe.connect(str(path))
            except ConnectionRefusedError:
                path.unlink(missing_ok=True)
                return
            except FileNotFoundError:
                return
        raise RuntimeError('Untracked SSH control socket is active; inspect ' + str(path))

    def stop_connection(self, key):
        paths = self.paths(key)
        while True:
            with self.lock():
                values = self.read_connection(key)
                if values and values.get('phase') == 'starting' and same_process(values.get('controller')):
                    if values['controller']['pid'] != os.getpid():
                        os.kill(values['controller']['pid'], signal.SIGTERM)
            try:
                with self.lock(paths.lock, nonblocking=True):
                    values = self.read_connection(key)
                    if values:
                        self.cleanup(key, values['id'])
                        if values.get('watcher_owned'):
                            self.systemctl('stop', unit=paths.unit, check=False)
                        print('Stopped ' + describe(values) + '.', flush=True)
                    return
            except BusyError:
                time.sleep(0.05)

    def stop(self, host=None, everything=False):
        with self.lock():
            active = self.connections()
            if everything:
                selected = active
            elif active:
                selected = [self.resolve_active(host)]
            else:
                selected = []
        for values in selected:
            self.stop_connection(values['key'])
        with self.lock():
            if not self.connections():
                self.remove_stale_socket(self.paths(LEGACY).ssh)
                if self.connections_dir.is_dir():
                    for directory in self.connections_dir.iterdir():
                        self.remove_stale_socket(directory / 'ssh.sock')
                        with contextlib.suppress(OSError):
                            directory.rmdir()
                owned = self.read_shared().get('devspace_owned')
                self.release_shared()
                if not selected and not owned and self.service_active():
                    if not self.unit_file.read_text().startswith(MARKER):
                        raise RuntimeError('The service unit is not managed by remote-dev')
                    self.systemctl('stop')
        print('Stopped. Authentication, profiles and project workloads are preserved.')

    def watch(self, key, identifier):
        server = None
        try:
            while True:
                with self.lock():
                    values = self.read_connection(key)
                    if not values or values['id'] != identifier:
                        return
                    if not self.connection_ready(values):
                        break
                    if server is None and values.get('clipboard_token'):
                        with contextlib.suppress(OSError):  # Image paste is optional; retry next round.
                            server = clipboard.serve(self.paths(key).clipboard, values['clipboard_token'])
                time.sleep(2)
        finally:
            if server:
                server.close()
            self.cleanup(key, identifier)

    def status(self, host=None):
        selected = [self.resolve_active(host)] if host else self.connections()
        service = self.service_active()
        shared = self.read_shared()
        browser = bool(any(item.get('browser') for item in selected) and self.browser.status()['chrome_running'])
        sessions = self.sessions()
        items = []
        for values in selected:
            ssh = self.control(values, 'check').returncode == 0
            owned = [{'id': record['id'], 'client': record['client'], 'paths': record['paths'],
                      'running': same_process(record.get('ssh'))}
                     for _, record in sessions if record.get('connection', LEGACY) == values['key']]
            items.append({'name': values.get('name'), 'host': values['host'], 'ssh_port': values['ssh_port'],
                          'key': values['key'],
                          'running': values.get('phase') == 'ready' and service and ssh,
                          'ssh_running': ssh, 'browser_requested': bool(values.get('browser')),
                          'oauth_callback': values['key'] in (LEGACY, shared.get('oauth_holder')),
                          'development_roots': values.get('scope', []), 'sessions': owned,
                          'active_sessions': sum(item['running'] for item in owned)})
        return {'running': any(item['running'] for item in items), 'service_running': service,
                'browser_running': browser, 'connections': items,
                'active_sessions': sum(item['active_sessions'] for item in items),
                'authentication': 'Check local-dev in Claude /mcp; not inferred from health.'}


def parser():
    result = argparse.ArgumentParser(description=__doc__)
    commands = result.add_subparsers(dest='command', required=True)
    prepared = commands.add_parser('install', help='Install local dependencies and configure an optional remote server')
    removed = commands.add_parser('uninstall', help='Remove owned installation resources, preserving user data')
    start = commands.add_parser('start', help='Start shared access to a remote server without launching Claude')
    start.add_argument('-H', '--host', help='SSH target [USER@]HOST[:PORT], a hostname prefix of a remembered '
                                            'target, or =TARGET to skip matching; '
                                            'default: the running connection or the last target')
    start.add_argument('--ssh-port', type=int, help='Default: remembered port or 22')
    start.add_argument('--browser', action='store_true', help='Start or borrow dedicated local Chrome')
    for command in [prepared, start]:
        command.add_argument('--name', help='Short name to select this server with -H; renames a remembered one')
    for command in [prepared, removed]:
        command.add_argument('-H', '--host', help='Optional remote server, resolved like start --host; '
                                                  'install remembers it, uninstall forgets it')
        command.add_argument('--ssh-port', type=int, help='Default: remembered port or 22')
    for command in [prepared, start, removed]:
        command.add_argument('-i', '--identity-file', help='Local SSH private key; never copied remotely')
    prepared.add_argument('--browser', action='store_true', help='Prepare local Chrome and remote browser MCP')
    prepared.add_argument('--with-node', dest='install_node', action='store_true', help='Install private Node24 if no compatible runtime exists')
    selector = ('Running connection: [USER@]HOST[:PORT], a hostname prefix, or =TARGET for exact; '
                'default: REMOTE_DEV_HOST or the only connection')
    opened = commands.add_parser('open', help='Open an independent Claude session; default directory is cwd')
    opened.add_argument('paths', nargs='*', help='Local repository directories')
    opened.add_argument('-H', '--host', help=selector)
    opened.add_argument('--client', choices=['claude'], default='claude', help='Default: claude; Codex is planned')
    synced = commands.add_parser('sync', help="Sync a workspace's Claude transcripts with running connections")
    synced.add_argument('paths', nargs='*', help='Local repository directories as given to open; default: cwd')
    synced.add_argument('-H', '--host', help='Running connection, resolved like open --host; default: all')
    status = commands.add_parser('status', help='Inspect shared access and individual sessions')
    status.add_argument('-H', '--host', help='Show one running connection; default: all')
    status.add_argument('--json', action='store_true')
    stopped = commands.add_parser('stop', help='Close a connection and its sessions')
    stopped.add_argument('-H', '--host', help=selector)
    stopped.add_argument('--all', action='store_true', help='Close every connection')
    auth = commands.add_parser('auth', help='Forward the local OAuth callback port 8765 to a connection')
    auth.add_argument('-H', '--host', help=selector)
    return result


def print_status(status):
    print('Connection: ' + ('running' if status['running'] else 'stopped or partial'))
    print('DevSpace: ' + ('running' if status['service_running'] else 'stopped'))
    for connection in status['connections']:
        print('%s %s%s%s' % (describe(connection),
            'running' if connection['running'] else 'partial',
            ', browser' if connection['browser_requested'] else '',
            ', OAuth callback' if connection['oauth_callback'] else ''))
        for item in connection['sessions']:
            print('  %s %s %s: %s' % (item['id'][:8], item['client'],
                'running' if item['running'] else 'stale', ', '.join(item['paths'])))
    print('Active sessions: ' + str(status['active_sessions']))


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    controller = Controller()
    def interrupted(_number, _frame):
        raise KeyboardInterrupt
    previous = {number: signal.signal(number, interrupted)
                for number in [signal.SIGTERM, signal.SIGHUP]}
    try:
        if argv[:1] == ['_watch']:
            key, identifier = argv[1:] if len(argv) == 3 else (LEGACY, argv[1])
            controller.watch(key, identifier)
            return 0
        args = parser().parse_args(argv)
        if args.command == 'install':
            controller.install(args.host, args.ssh_port, args.identity_file, args.browser, args.install_node, args.name)
        elif args.command == 'start':
            controller.start(args.host, args.ssh_port, args.browser, args.identity_file, args.name)
        elif args.command == 'uninstall':
            controller.uninstall(args.host, args.ssh_port, args.identity_file)
        elif args.command == 'open':
            return controller.open(args.paths, args.client, args.host)
        elif args.command == 'sync':
            controller.sync(args.paths, args.host)
        elif args.command == 'stop':
            controller.stop(args.host, args.all)
        elif args.command == 'auth':
            controller.auth(args.host)
        else:
            status = controller.status(args.host)
            if args.json:
                print(json.dumps(status, indent=2))
            else:
                print_status(status)
            return 0 if status['running'] else 1
        return 0
    except KeyboardInterrupt:
        print('\nInterrupted.', file=sys.stderr)
        return 130
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print('Error: ' + str(error), file=sys.stderr)
        return 2
    finally:
        for number, handler in previous.items():
            signal.signal(number, handler)


if __name__ == '__main__':
    sys.exit(main())
